# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to Git.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zero_trust_iot
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here

# --- Ganache / Blockchain ---
GANACHE_RPC_URL=http://127.0.0.1:7545
CHAIN_ID=1337
# Admin account private key exported from Ganache (used ONLY for
# server-side/script operations like registering devices). Never
# use a mainnet key here - Ganache keys are fake test funds only.
ADMIN_PRIVATE_KEY=0xreplace_with_a_ganache_account_private_key

# Contract addresses (filled in after Phase 13 deployment)
DEVICE_IDENTITY_CONTRACT_ADDRESS=
ACCESS_CONTROL_CONTRACT_ADDRESS=
AUDIT_LOG_CONTRACT_ADDRESS=
